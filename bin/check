#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
NAME = "artisan"
MAX_BODY_WORDS = 250
MAX_DESCRIPTION_CHARS = 1024
SKILLS = tuple(sorted(path.name for path in (ROOT / "skills").iterdir() if path.is_dir()))
RETIRED_SKILLS = (
    "artisan-build",
    "artisan-debug",
    "artisan-frontend-design",
    "artisan-kotlin-backend",
    "artisan-parallel",
    "artisan-php",
    "artisan-react",
    "artisan-review",
    "artisan-shape",
    "artisan-typescript",
    "artisan-visual-brainstorming",
    "artisan-web-art-direction",
)
ALLOWED_FRONTMATTER_FIELDS = {"allowed-tools", "description", "license", "metadata", "name"}


def quoted_value(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return None


def base_version(version):
    return version.split("+", 1)[0] if isinstance(version, str) else version


def interface_errors(skill):
    path = ROOT / "skills" / skill / "agents/openai.yaml"
    if not path.is_file():
        return [f"missing interface metadata: {path}"]
    values = {}
    for line in path.read_text().splitlines():
        if line.startswith("  ") and not line.startswith("    ") and ":" in line:
            key, value = line.strip().split(":", 1)
            values[key] = quoted_value(value)
    errors = []
    for field in ("display_name", "short_description", "default_prompt"):
        if not values.get(field):
            errors.append(f"missing or unquoted {field}: {path}")
    short_description = values.get("short_description") or ""
    if short_description and not 25 <= len(short_description) <= 64:
        errors.append(f"invalid short_description length: {path}")
    default_prompt = values.get("default_prompt") or ""
    if default_prompt and f"${skill}" not in default_prompt:
        errors.append(f"default_prompt must mention ${skill}: {path}")
    return errors


def skill_errors(skill):
    path = ROOT / "skills" / skill / "SKILL.md"
    if not path.is_file():
        return [f"missing {path}"]
    text = path.read_text().strip()
    parts = text.split("---", 2)
    if len(parts) != 3 or not text.startswith("---"):
        return [f"invalid frontmatter: {path}"]
    frontmatter, body = parts[1], parts[2]
    errors = []
    fields = {}
    for line in frontmatter.splitlines():
        if not line.strip() or line.startswith((" ", "\t")):
            continue
        if ":" not in line:
            errors.append(f"invalid frontmatter line in {path}: {line}")
            continue
        key, value = line.split(":", 1)
        if key in fields:
            errors.append(f"duplicate frontmatter field {key}: {path}")
        fields[key] = value.strip()
    for field in sorted(set(fields) - ALLOWED_FRONTMATTER_FIELDS):
        errors.append(f"unsupported frontmatter field {field}: {path}")
    name = quoted_value(fields.get("name", "")) or fields.get("name", "")
    if name != skill:
        errors.append(f"wrong name: {path}")
    description_lines = []
    collecting_description = False
    for line in frontmatter.splitlines():
        if line.startswith("description: "):
            description_lines = [line.removeprefix("description: ")]
            break
        if line == "description:":
            collecting_description = True
            continue
        if collecting_description and line.startswith((" ", "\t")):
            description_lines.append(line.strip())
            continue
        if collecting_description:
            break
    description = " ".join(description_lines)
    if not description.startswith("Use when "):
        errors.append(f"missing trigger description: {path}")
    if len(description) > MAX_DESCRIPTION_CHARS:
        errors.append(f"overlong description: {path}")
    if len(body.split()) > MAX_BODY_WORDS:
        errors.append(f"over {MAX_BODY_WORDS} words: {path}")
    errors.extend(interface_errors(skill))
    return errors


def main():
    errors = []
    try:
        codex_manifest = json.loads((ROOT / ".codex-plugin/plugin.json").read_text())
        claude_manifest = json.loads((ROOT / ".claude-plugin/plugin.json").read_text())
        marketplace = json.loads((ROOT / ".claude-plugin/marketplace.json").read_text())
        if codex_manifest.get("name") != NAME or codex_manifest.get("skills") != "./skills/":
            errors.append("invalid Codex plugin manifest")
        if codex_manifest.get("name") != claude_manifest.get("name"):
            errors.append("plugin manifest name mismatch")
        release_version = base_version(codex_manifest.get("version"))
        if release_version != base_version(claude_manifest.get("version")):
            errors.append("plugin manifest version mismatch")
        if release_version != base_version(marketplace.get("metadata", {}).get("version")):
            errors.append("plugin marketplace version mismatch")
    except (OSError, json.JSONDecodeError) as error:
        errors.append(f"invalid plugin manifest: {error}")
    for skill in SKILLS:
        errors.extend(skill_errors(skill))

    home = Path(os.environ["HOME"])
    expected_links = [(home / "plugins" / NAME, ROOT)]
    expected_links += [
        (home / runtime / skill, ROOT / "skills" / skill)
        for runtime in (".agents/skills", ".claude/skills")
        for skill in SKILLS
    ]
    for path, target in expected_links:
        if not path.is_symlink() or path.resolve() != target.resolve():
            errors.append(f"missing link: {path}")
    for runtime in (".agents/skills", ".claude/skills"):
        for skill in RETIRED_SKILLS:
            path = home / runtime / skill
            if path.exists() or path.is_symlink():
                errors.append(f"stale retired skill: {path}")
    try:
        plugins = json.loads((home / ".agents/plugins/marketplace.json").read_text()).get("plugins", [])
        if not any(plugin.get("name") == NAME for plugin in plugins):
            errors.append("missing marketplace entry")
    except (OSError, json.JSONDecodeError) as error:
        errors.append(f"invalid marketplace: {error}")

    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print("ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
