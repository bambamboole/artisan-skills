#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
NAME = "artisan"
MAX_BODY_WORDS = 250
MAX_DESCRIPTION_CHARS = 1024
SKILLS = (
    "artisan-shape",
    "artisan-build",
    "artisan-debug",
    "artisan-review",
    "artisan-parallel",
    "artisan-frontend-design",
    "artisan-visual-brainstorming",
    "artisan-php",
    "artisan-react",
    "artisan-typescript",
    "writing",
)
RETIRED_SKILLS = ("artisan-kotlin-backend", "artisan-web-art-direction")


def skill_errors(skill):
    path = ROOT / "skills" / skill / "SKILL.md"
    if not path.is_file():
        return [f"missing {path}"]
    text = path.read_text().strip()
    parts = text.split("---", 2)
    if len(parts) != 3 or not text.startswith("---"):
        return [f"invalid frontmatter: {path}"]
    frontmatter, body = parts[1], parts[2]
    errors = []
    if f"name: {skill}" not in frontmatter:
        errors.append(f"wrong name: {path}")
    description_lines = []
    collecting_description = False
    for line in frontmatter.splitlines():
        if line.startswith("description: "):
            description_lines = [line.removeprefix("description: ")]
            break
        if line == "description:":
            collecting_description = True
            continue
        if collecting_description and line.startswith((" ", "\t")):
            description_lines.append(line.strip())
            continue
        if collecting_description:
            break
    description = " ".join(description_lines)
    if not description.startswith("Use when "):
        errors.append(f"missing trigger description: {path}")
    if len(description) > MAX_DESCRIPTION_CHARS:
        errors.append(f"overlong description: {path}")
    if len(body.split()) > MAX_BODY_WORDS:
        errors.append(f"over {MAX_BODY_WORDS} words: {path}")
    return errors


def main():
    errors = []
    try:
        manifest = json.loads((ROOT / ".codex-plugin/plugin.json").read_text())
        if manifest.get("name") != NAME or manifest.get("skills") != "./skills/":
            errors.append("invalid plugin manifest")
    except (OSError, json.JSONDecodeError) as error:
        errors.append(f"invalid plugin manifest: {error}")
    for skill in SKILLS:
        errors.extend(skill_errors(skill))

    home = Path(os.environ["HOME"])
    expected_links = [(home / "plugins" / NAME, ROOT)]
    expected_links += [
        (home / runtime / skill, ROOT / "skills" / skill)
        for runtime in (".agents/skills", ".claude/skills")
        for skill in SKILLS
    ]
    for path, target in expected_links:
        if not path.is_symlink() or path.resolve() != target.resolve():
            errors.append(f"missing link: {path}")
    for runtime in (".agents/skills", ".claude/skills"):
        for skill in RETIRED_SKILLS:
            path = home / runtime / skill
            if path.exists() or path.is_symlink():
                errors.append(f"stale retired skill: {path}")
    try:
        plugins = json.loads((home / ".agents/plugins/marketplace.json").read_text()).get("plugins", [])
        if not any(plugin.get("name") == NAME for plugin in plugins):
            errors.append("missing marketplace entry")
    except (OSError, json.JSONDecodeError) as error:
        errors.append(f"invalid marketplace: {error}")

    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print("ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
